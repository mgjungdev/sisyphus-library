      "sense_ko": "(병·고통으로) 시달리는",
      "synonyms": [
        {
          "word": "stricken",
          "nuance": "Stronger and more sudden; often used for shock or disaster, not only illness.",
          "example": "stricken with grief"
        },
        {
          "word": "troubled",
          "nuance": "Milder and vaguer; can be worry as well as physical illness.",
          "example": "troubled by back pain"
        },
        {
          "word": "suffering",
          "nuance": "Neutral, everyday; needs 'from' and does not sound formal.",
          "example": "suffering from a cold"
        }
      ],
      "modern": "\"afflicted with\" → \"suffering from\"",
      "tip_ko": null,
      "all": false
    },
