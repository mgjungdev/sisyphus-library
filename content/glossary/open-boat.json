{
  "slug": "open-boat",
  "entries": [
    {"id": "slate", "match": "slate", "para": 3, "headword": "slate", "pos": "noun", "ipa": "/sleɪt/", "sense_en": "a dark blue-grey colour, like the stone used on roofs", "sense_ko": "청회색, 슬레이트 색", "synonyms": [{"word": "charcoal", "nuance": "Darker and blacker grey, like burnt wood; slate has a cold bluish tint.", "example": "a charcoal coat"}, {"word": "leaden", "nuance": "Heavy, dull grey that suggests gloom, often used for skies and seas.", "example": "a leaden sky"}], "modern": null, "tip_ko": null},
    {"id": "jagged", "match": "jagged", "para": 3, "headword": "jagged", "pos": "adjective", "ipa": "/ˈdʒæɡɪd/", "sense_en": "having a rough edge with sharp, uneven points", "sense_ko": "들쭉날쭉한, 톱니처럼 삐죽삐죽한", "synonyms": [{"word": "rugged", "nuance": "Rough and uneven, but usually describes land or faces, not a sharp edge.", "example": "a rugged coastline"}, {"word": "serrated", "nuance": "Technical: a regular row of teeth, like a bread knife.", "example": "a serrated blade"}], "modern": null, "tip_ko": "발음은 '재기드' (jag-ged, 두 음절)."},
    {"id": "squat", "match": "squatted", "para": 5, "headword": "squat", "pos": "verb", "ipa": "/skwɑt/", "sense_en": "sat low to the ground with knees bent", "sense_ko": "쪼그리고 앉았다", "synonyms": [{"word": "crouch", "nuance": "Bend low, often to hide or be ready to move; the body leans forward.", "example": "He crouched behind the wall."}, {"word": "hunker down", "nuance": "Informal: settle low and stay put, usually against danger or bad weather.", "example": "We hunkered down during the storm."}], "modern": null, "tip_ko": null},
    {"id": "gunwale", "match": "gunwale", "para": 5, "headword": "gunwale", "pos": "noun", "ipa": "/ˈɡʌnəl/", "sense_en": "the upper edge of the side of a boat", "sense_ko": "뱃전, 배의 가장자리 윗부분", "synonyms": [{"word": "rail", "nuance": "General word for the barrier or edge along a ship's side.", "example": "He leaned on the rail."}, {"word": "side", "nuance": "Everyday, vague: the whole wall of the boat, not just its top edge.", "example": "the side of the boat"}], "modern": null, "tip_ko": "철자와 달리 '거널'로 발음한다."},
    {"id": "bail-out", "match": "bail out", "para": 5, "headword": "bail out", "pos": "phrase", "ipa": null, "sense_en": "to scoop water out of a boat so that it does not sink", "sense_ko": "(배에 찬) 물을 퍼내다", "synonyms": [{"word": "scoop out", "nuance": "Plain description; does not suggest an emergency the way bail does.", "example": "scoop out the water"}, {"word": "pump out", "nuance": "Uses a machine or pump, not a hand or bucket.", "example": "pump out the cellar"}], "modern": null, "tip_ko": "'bail out'은 재정적으로 구제하다 또는 낙하산 탈출의 뜻도 있다."},
    {"id": "dejection", "match": "dejection", "para": 8, "headword": "dejection", "pos": "noun", "ipa": "/dɪˈdʒɛkʃən/", "sense_en": "a low, sad, hopeless mood", "sense_ko": "낙담, 의기소침", "synonyms": [{"word": "despondency", "nuance": "Deeper loss of hope over a longer time; more formal.", "example": "He sank into despondency."}, {"word": "gloom", "nuance": "A general dark mood, not always tied to a specific defeat.", "example": "a mood of gloom"}, {"word": "sadness", "nuance": "Plain feeling of sorrow; lacks the sense of defeat in dejection.", "example": "a deep sadness"}], "modern": null, "tip_ko": null},
    {"id": "willy-nilly", "match": "willy nilly", "para": 8, "headword": "willy-nilly", "pos": "adverb", "ipa": "/ˌwɪli ˈnɪli/", "sense_en": "whether one wants it or not", "sense_ko": "좋든 싫든, 어쩔 수 없이", "synonyms": [{"word": "whether or not", "nuance": "Plain, neutral phrase for something that happens regardless of wishes.", "example": "It will happen whether or not we agree."}, {"word": "at random", "nuance": "Another common meaning of willy-nilly: without order or plan.", "example": "papers scattered at random"}], "modern": null, "tip_ko": "'무질서하게'라는 뜻으로도 쓰인다."},
    {"id": "bucking-broncho", "match": "bucking broncho", "para": 11, "headword": "bucking bronco", "pos": "phrase", "ipa": "/ˈbʌkɪŋ ˈbrɑŋkoʊ/", "sense_en": "a wild horse that jumps and kicks to throw off its rider", "sense_ko": "날뛰며 기수를 떨어뜨리려는 야생마", "synonyms": [{"word": "wild horse", "nuance": "Plain description without the rodeo image of jumping.", "example": "a wild horse on the plains"}, {"word": "unbroken horse", "nuance": "A horse never trained to be ridden.", "example": "an unbroken colt"}], "modern": "\"broncho\" → \"bronco\"", "tip_ko": null},
    {"id": "by-the-same-token", "match": "by the same token", "para": 11, "headword": "by the same token", "pos": "idiom", "ipa": null, "sense_en": "for the same reason; in the same way", "sense_ko": "같은 이유로, 마찬가지로", "synonyms": [{"word": "likewise", "nuance": "Simple link meaning 'in the same way'.", "example": "She left, and likewise did he."}, {"word": "by the same logic", "nuance": "Stresses that a conclusion follows by the same reasoning.", "example": "By the same logic, we should stay."}], "modern": null, "tip_ko": null},
    {"id": "surmount", "match": "surmounting", "para": 12, "headword": "surmount", "pos": "verb", "ipa": "/sərˈmaʊnt/", "sense_en": "getting over or past (an obstacle)", "sense_ko": "(장애물을) 넘다, 극복하다", "synonyms": [{"word": "overcome", "nuance": "Most common; used for problems, fears or enemies.", "example": "overcome a fear"}, {"word": "climb over", "nuance": "Literal physical movement up and across something.", "example": "climb over a fence"}, {"word": "clear", "nuance": "Get over without touching, as in a jump.", "example": "clear the bar"}], "modern": null, "tip_ko": null},
    {"id": "swamp", "match": "swamping", "para": 12, "headword": "swamp", "pos": "verb", "ipa": "/swɑmp/", "sense_en": "filling a boat with water so it sinks or is useless", "sense_ko": "(배를) 물에 잠기게 하다", "synonyms": [{"word": "capsize", "nuance": "Turn upside down; swamping means filling with water, while the boat may stay upright.", "example": "The canoe capsized."}, {"word": "flood", "nuance": "Fill with water; general, not limited to boats.", "example": "The river flooded the fields."}, {"word": "engulf", "nuance": "Literary: surround and cover completely.", "example": "Waves engulfed the deck."}], "modern": null, "tip_ko": "명사 swamp(늪)와 같은 단어다."},
    {"id": "wan", "match": "wan", "para": 13, "headword": "wan", "pos": "adjective", "ipa": "/wɑn/", "sense_en": "pale and weak-looking; dim", "sense_ko": "희미한, 창백한", "synonyms": [{"word": "pale", "nuance": "Everyday word for light colour; does not suggest weakness.", "example": "a pale face"}, {"word": "pallid", "nuance": "Sickly pale; more negative and formal.", "example": "a pallid complexion"}, {"word": "faint", "nuance": "Barely visible or audible, of light or sound.", "example": "a faint light"}], "modern": null, "tip_ko": null},
    {"id": "glint", "match": "glinted", "para": 13, "headword": "glint", "pos": "verb", "ipa": "/ɡlɪnt/", "sense_en": "shone with a quick, small flash of light", "sense_ko": "반짝이다", "synonyms": [{"word": "sparkle", "nuance": "Many small bright flashes; cheerful.", "example": "Her ring sparkled."}, {"word": "gleam", "nuance": "Steadier, softer shine.", "example": "The floor gleamed."}, {"word": "flash", "nuance": "A single sudden, bright burst of light.", "example": "Lightning flashed."}], "modern": null, "tip_ko": null},
    {"id": "astern", "match": "astern", "para": 13, "headword": "astern", "pos": "adverb", "ipa": "/əˈstɜrn/", "sense_en": "toward the back of the boat", "sense_ko": "선미 쪽으로, 뒤쪽으로", "synonyms": [{"word": "aft", "nuance": "Also 'at the rear of a ship', but describes position; astern often means behind the ship.", "example": "the cabin aft"}, {"word": "behind", "nuance": "Ordinary word for any position at the back.", "example": "the car behind us"}], "modern": null, "tip_ko": null},
    {"id": "picturesque", "match": "picturesque", "para": 13, "headword": "picturesque", "pos": "adjective", "ipa": "/ˌpɪktʃəˈrɛsk/", "sense_en": "pretty in a way that would make a good picture", "sense_ko": "그림 같은, 풍경이 아름다운", "synonyms": [{"word": "scenic", "nuance": "Describes a route or view with fine scenery.", "example": "a scenic drive"}, {"word": "charming", "nuance": "Pleasant and attractive, not necessarily like a picture.", "example": "a charming cottage"}, {"word": "quaint", "nuance": "Old-fashioned and cute.", "example": "a quaint village"}], "modern": null, "tip_ko": "강세는 -resque에 온다."},
    {"id": "grub", "match": "grub", "para": 17, "headword": "grub", "pos": "noun", "ipa": "/ɡrʌb/", "sense_en": "food (informal)", "sense_ko": "먹을 것, 음식(구어)", "synonyms": [{"word": "chow", "nuance": "American slang for food, often plain and hearty.", "example": "Time for chow."}, {"word": "food", "nuance": "Neutral, standard word.", "example": "hot food"}, {"word": "provisions", "nuance": "Formal: supplies of food stored for a trip.", "example": "provisions for the journey"}], "modern": null, "tip_ko": "원래 '애벌레'라는 뜻도 있다."},
    {"id": "have-a-show", "match": "have a show", "para": 25, "headword": "have a show", "pos": "idiom", "ipa": null, "sense_en": "to have any chance of success", "sense_ko": "가망이 있다, 승산이 있다", "synonyms": [{"word": "stand a chance", "nuance": "Modern, common phrase for having some hope of success.", "example": "We don't stand a chance."}, {"word": "have a shot", "nuance": "Informal: get a chance to try, not always likely to succeed.", "example": "He has a shot at the title."}], "modern": "\"wouldn't have a show\" → \"wouldn't stand a chance\"", "tip_ko": "'쇼'와는 상관없는 오래된 미국식 표현."},
    {"id": "hemming-and-hawing", "match": "hemming and hawing", "para": 29, "headword": "hem and haw", "pos": "idiom", "ipa": null, "sense_en": "making unsure noises and pauses instead of answering clearly", "sense_ko": "우물쭈물하다, 얼버무리다", "synonyms": [{"word": "hesitate", "nuance": "Neutral: pause before acting or speaking.", "example": "She hesitated before answering."}, {"word": "dither", "nuance": "Cannot decide, going back and forth; slightly critical.", "example": "Stop dithering!"}, {"word": "stammer", "nuance": "Repeat sounds because of nerves or a speech problem.", "example": "He stammered an apology."}], "modern": null, "tip_ko": null},
    {"id": "doggedly", "match": "doggedly", "para": 29, "headword": "doggedly", "pos": "adverb", "ipa": "/ˈdɔɡɪdli/", "sense_en": "in a stubborn, refusing-to-give-up way", "sense_ko": "끈덕지게, 집요하게", "synonyms": [{"word": "stubbornly", "nuance": "Often negative: refusing to change one's mind.", "example": "He stubbornly refused."}, {"word": "tenaciously", "nuance": "Formal, admiring: holding firmly to a goal.", "example": "She tenaciously defended her work."}, {"word": "persistently", "nuance": "Neutral: keeping on for a long time.", "example": "He persistently called."}], "modern": null, "tip_ko": null},
    {"id": "catch-hell", "match": "catch hell", "para": 32, "headword": "catch hell", "pos": "idiom", "ipa": null, "sense_en": "to suffer badly or be severely punished", "sense_ko": "혹독한 꼴을 당하다", "synonyms": [{"word": "get in trouble", "nuance": "Mild, everyday: be punished or scolded.", "example": "You'll get in trouble for that."}, {"word": "go through hell", "nuance": "Suffer a long terrible experience.", "example": "She went through hell."}], "modern": null, "tip_ko": "구어이며 거친 표현이다."},
    {"id": "wrath", "match": "wrath", "para": 33, "headword": "wrath", "pos": "noun", "ipa": "/ræθ/", "sense_en": "very great anger, especially the violent kind", "sense_ko": "격노, 분노", "synonyms": [{"word": "fury", "nuance": "Wild, uncontrolled anger, less formal than wrath.", "example": "She screamed in fury."}, {"word": "rage", "nuance": "Sudden explosive anger.", "example": "a fit of rage"}, {"word": "anger", "nuance": "Ordinary word, any strength.", "example": "He felt anger."}], "modern": null, "tip_ko": "'th'는 혀를 물고 발음한다. '라스'가 아님."},
    {"id": "covey", "match": "covey", "para": 33, "headword": "covey", "pos": "noun", "ipa": "/ˈkʌvi/", "sense_en": "a small group of game birds such as quail or grouse", "sense_ko": "(메추라기 등의) 작은 새 떼", "synonyms": [{"word": "flock", "nuance": "General word for a group of birds or sheep.", "example": "a flock of geese"}, {"word": "brood", "nuance": "Young birds hatched together.", "example": "a brood of chicks"}], "modern": null, "tip_ko": null},
    {"id": "uncanny", "match": "uncanny", "para": 33, "headword": "uncanny", "pos": "adjective", "ipa": "/ʌnˈkæni/", "sense_en": "strange in a way that feels slightly frightening", "sense_ko": "기이한, 으스스한", "synonyms": [{"word": "eerie", "nuance": "Strange and frightening, especially in a quiet place.", "example": "an eerie silence"}, {"word": "weird", "nuance": "Odd, not always scary.", "example": "a weird noise"}, {"word": "spooky", "nuance": "Informal: like a ghost story.", "example": "a spooky old house"}], "modern": null, "tip_ko": null},
    {"id": "scrutiny", "match": "scrutiny", "para": 33, "headword": "scrutiny", "pos": "noun", "ipa": "/ˈskrutəni/", "sense_en": "a long, careful, searching look", "sense_ko": "면밀한 관찰, 유심히 쳐다봄", "synonyms": [{"word": "inspection", "nuance": "Official, checking for faults.", "example": "a safety inspection"}, {"word": "stare", "nuance": "A long look, often rude, without the idea of examining.", "example": "a blank stare"}, {"word": "examination", "nuance": "Careful check by a professional.", "example": "a medical examination"}], "modern": null, "tip_ko": null},
    {"id": "alight", "match": "alight", "para": 33, "headword": "alight", "pos": "verb", "ipa": "/əˈlaɪt/", "sense_en": "to come down and land on something", "sense_ko": "내려앉다", "synonyms": [{"word": "land", "nuance": "Ordinary word for touching down.", "example": "The bird landed on the roof."}, {"word": "perch", "nuance": "Sit on a branch or ledge, not just arrive.", "example": "A robin perched on the fence."}, {"word": "settle", "nuance": "Come to rest gently and stay.", "example": "Dust settled on the shelf."}], "modern": "\"alight\" (birds) → \"land\"", "tip_ko": "'alight'에는 '불이 붙은'이라는 형용사 뜻도 있다."},
    {"id": "grewsome", "match": "grewsome", "para": 33, "headword": "gruesome", "pos": "adjective", "ipa": "/ˈɡrusəm/", "sense_en": "horrible and disturbing, connected with death", "sense_ko": "섬뜩한, 끔찍한", "synonyms": [{"word": "grisly", "nuance": "Very close; often for violent death or crime scenes.", "example": "a grisly discovery"}, {"word": "ghastly", "nuance": "Shocking or very bad, also used loosely.", "example": "a ghastly mistake"}, {"word": "macabre", "nuance": "Deals with death in a dark, creepy way.", "example": "a macabre story"}], "modern": "\"grewsome\" → \"gruesome\"", "tip_ko": null},
    {"id": "ominous", "match": "ominous", "para": 33, "headword": "ominous", "pos": "adjective", "ipa": "/ˈɑmənəs/", "sense_en": "suggesting that something bad will happen", "sense_ko": "불길한, 흉조의", "synonyms": [{"word": "threatening", "nuance": "Shows clear danger or harm, not just a bad feeling.", "example": "a threatening look"}, {"word": "foreboding", "nuance": "A feeling of coming evil (also a noun).", "example": "a sense of foreboding"}, {"word": "sinister", "nuance": "Evil or harmful intent seems hidden.", "example": "a sinister smile"}], "modern": null, "tip_ko": "강세는 첫 음절."},
    {"id": "thwart", "match": "thwart", "para": 35, "headword": "thwart", "pos": "noun", "ipa": "/θwɔrt/", "sense_en": "a seat across a small boat, on which a rower sits", "sense_ko": "(작은 배의) 가로 좌석, 노 젓는 자리", "synonyms": [{"word": "bench", "nuance": "Everyday word for a seat; thwart is specific to boats.", "example": "a bench in the boat"}, {"word": "seat", "nuance": "Most general word.", "example": "a rowing seat"}], "modern": null, "tip_ko": "동사 thwart(좌절시키다)와 철자가 같다.", "all": false},
    {"id": "sidle", "match": "sidled", "para": 35, "headword": "sidle", "pos": "verb", "ipa": "/ˈsaɪdəl/", "sense_en": "moved sideways, slowly and carefully", "sense_ko": "게걸음으로 살금살금 움직이다", "synonyms": [{"word": "edge", "nuance": "Move slowly little by little, in any direction.", "example": "She edged toward the door."}, {"word": "creep", "nuance": "Move very quietly and low, often secretly.", "example": "He crept upstairs."}, {"word": "slink", "nuance": "Move smoothly and guiltily.", "example": "The dog slunk away."}], "modern": null, "tip_ko": null},
    {"id": "to-all-intents", "match": "to all intents", "para": 36, "headword": "to all intents and purposes", "pos": "idiom", "ipa": null, "sense_en": "in every way that matters; practically", "sense_ko": "사실상, 모든 점에서", "synonyms": [{"word": "in effect", "nuance": "Shorter; describes the real result even if not official.", "example": "In effect, he is the boss."}, {"word": "virtually", "nuance": "Almost completely, but not quite.", "example": "It is virtually finished."}, {"word": "practically", "nuance": "Almost, from a practical point of view.", "example": "practically free"}], "modern": null, "tip_ko": null},
    {"id": "stationary", "match": "stationary", "para": 36, "headword": "stationary", "pos": "adjective", "ipa": "/ˈsteɪʃəˌnɛri/", "sense_en": "not moving", "sense_ko": "정지해 있는", "synonyms": [{"word": "motionless", "nuance": "Completely still, often by choice or from calm.", "example": "She stood motionless."}, {"word": "static", "nuance": "Not changing, in science or design.", "example": "a static image"}, {"word": "fixed", "nuance": "Attached, cannot move.", "example": "a fixed position"}], "modern": null, "tip_ko": "stationery(문구)와 철자가 비슷해 자주 혼동된다."},
    {"id": "wallow", "match": "wallowing", "para": 44, "headword": "wallow", "pos": "verb", "ipa": "/ˈwɑloʊ/", "sense_en": "rolling and tossing helplessly in the water", "sense_ko": "(물 위에서) 뒹굴다, 출렁이며 허우적대다", "synonyms": [{"word": "flounder", "nuance": "Struggle clumsily and helplessly.", "example": "He floundered in the mud."}, {"word": "toss", "nuance": "Move roughly up and down or side to side.", "example": "The boat tossed."}, {"word": "roll", "nuance": "Sway from side to side; less helpless.", "example": "The ship rolled."}], "modern": null, "tip_ko": null},
    {"id": "serenely", "match": "serenely", "para": 45, "headword": "serenely", "pos": "adverb", "ipa": "/səˈrinli/", "sense_en": "in a calm, untroubled way", "sense_ko": "평온하게, 침착하게", "synonyms": [{"word": "calmly", "nuance": "General: without panic.", "example": "She spoke calmly."}, {"word": "placidly", "nuance": "Quiet and slow to anger; a little dull.", "example": "cows grazing placidly"}, {"word": "tranquilly", "nuance": "Peaceful, like a still scene.", "example": "The lake lay tranquilly."}], "modern": null, "tip_ko": null},
    {"id": "motley", "match": "motley", "para": 48, "headword": "motley", "pos": "adjective", "ipa": "/ˈmɑtli/", "sense_en": "made up of very different kinds of people or things", "sense_ko": "잡다한, 각양각색의", "synonyms": [{"word": "assorted", "nuance": "Neutral, of different kinds.", "example": "assorted candies"}, {"word": "ragtag", "nuance": "Untidy, poorly matched group.", "example": "a ragtag crew"}, {"word": "diverse", "nuance": "Positive: rich variety.", "example": "a diverse team"}], "modern": null, "tip_ko": null},
    {"id": "cynical", "match": "cynical", "para": 48, "headword": "cynical", "pos": "adjective", "ipa": "/ˈsɪnɪkəl/", "sense_en": "believing that people act only from selfish reasons", "sense_ko": "냉소적인, 사람을 믿지 않는", "synonyms": [{"word": "skeptical", "nuance": "Doubting a claim until shown proof; less bitter.", "example": "I'm skeptical of ads."}, {"word": "distrustful", "nuance": "Unwilling to trust a specific person.", "example": "distrustful of strangers"}, {"word": "pessimistic", "nuance": "Expecting things to go badly.", "example": "a pessimistic forecast"}], "modern": null, "tip_ko": null},
    {"id": "scull", "match": "scull", "para": 49, "headword": "scull", "pos": "verb", "ipa": "/skʌl/", "sense_en": "to move or steer a boat with a single oar at the back", "sense_ko": "(고물의 노 하나로) 배를 젓다", "synonyms": [{"word": "row", "nuance": "General: pull oars to move a boat.", "example": "row across the lake"}, {"word": "paddle", "nuance": "Use a short paddle, not fixed oars.", "example": "paddle a canoe"}, {"word": "steer", "nuance": "Control direction only.", "example": "steer the boat"}], "modern": null, "tip_ko": "skull(두개골)과 발음이 같다."},
